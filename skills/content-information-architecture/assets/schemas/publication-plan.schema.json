{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xelius.example/schemas/publication-plan.schema.json",
  "title": "Publication plan",
  "type": "object",
  "required": ["projectId", "archetype", "format", "frontMatter", "sections", "annexStrategy", "referencesStrategy"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "projectId": {"type": "string"},
    "archetype": {"enum": ["annual-report", "research-report", "case-study", "policy-brief", "white-paper", "toolkit", "training-manual"]},
    "format": {
      "type": "object",
      "required": ["size", "orientation", "delivery"],
      "properties": {
        "size": {"enum": ["A4", "US-Letter", "custom"]},
        "orientation": {"enum": ["portrait", "landscape"]},
        "delivery": {"enum": ["digital", "print", "both"]},
        "customDimensions": {"type": "string"}
      },
      "additionalProperties": false
    },
    "frontMatter": {"type": "array", "items": {"type": "string"}},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "pageFamilies", "evidenceIds"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "purpose": {"type": "string"},
          "estimatedPages": {"type": "integer", "minimum": 1},
          "pageFamilies": {"type": "array", "items": {"type": "string"}},
          "evidenceIds": {"type": "array", "items": {"type": "string"}},
          "visualOpportunities": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "annexStrategy": {"type": "string"},
    "referencesStrategy": {"type": "string"}
  },
  "additionalProperties": false
}
